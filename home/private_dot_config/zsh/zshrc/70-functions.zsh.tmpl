# 70-functions.zsh — custom functions

# Identify install subcommands without requiring them to precede global options.
function _dotfiles_is_capturable_install() {
  emulate -L zsh
  local manager=$1
  shift

  case "$manager" in
    brew)
      local arg
      for arg in "$@"; do
        [[ "$arg" == "--" ]] && continue
        [[ "$arg" == -* ]] && continue
        if [[ "$arg" == "install" ]]; then
          return 0
        fi
        return 1
      done
      ;;
    uv)
      local -a args=("$@")
      local -A options_with_values=(
        --allow-insecure-host 1
        --cache-dir 1
        --color 1
        --config-file 1
        --directory 1
        --project 1
        --trusted-host 1
      )
      local arg
      local index=1
      local expected_command=tool

      while (( index <= ${#args} )); do
        arg=${args[index]}
        if (( ${+options_with_values[$arg]} )); then
          (( index += 2 ))
        elif [[ "$arg" == "--" || "$arg" == -* ]]; then
          (( index += 1 ))
        elif [[ "$arg" == "$expected_command" ]]; then
          [[ "$expected_command" == "install" ]] && return 0
          # uv accepts global options between `tool` and `install` too.
          expected_command=install
          (( index += 1 ))
        else
          return 1
        fi
      done
      ;;
  esac

  return 1
}

# Capture successful interactive tool installs while preserving the original
# command's output and exit status.
function brew() {
  command brew "$@"
  local command_status=$?

  if (( command_status == 0 )) &&
    [[ -o interactive && -t 0 && -t 1 ]] &&
    _dotfiles_is_capturable_install brew "$@" &&
    command -v dotfiles-tool-capture >/dev/null 2>&1; then
    command dotfiles-tool-capture brew || true
  fi

  return $command_status
}

function uv() {
  command uv "$@"
  local command_status=$?

  if (( command_status == 0 )) &&
    [[ -o interactive && -t 0 && -t 1 ]] &&
    _dotfiles_is_capturable_install uv "$@" &&
    command -v dotfiles-tool-capture >/dev/null 2>&1; then
    command dotfiles-tool-capture uv || true
  fi

  return $command_status
}

# Source secrets loading function
source "${XDG_CONFIG_HOME:-$HOME/.config}/direnv/lib/secrets.sh"

function llm() {
  local openrouter_key
  if ! openrouter_key="$(load_secret keys/openrouter/llm)"; then
    print -r -- "Error: Could not load keys/openrouter/llm from pass." >&2
    return 1
  fi
  OPENROUTER_KEY="$openrouter_key" command llm "$@"
}


function please() {
  local include_explanation="false"

  # Parse optional -e flag
  if [[ "$1" == "-e" ]]; then
    include_explanation="true"
    shift # Remove the -e flag from the argument list
  fi

  # Guard clause: Ensure the user typed a request after the optional flag
  if [ $# -eq 0 ]; then
    echo "Error: Please describe what you want to do." >&2
    return 1
  fi

  local user_goal="$*"
  local sys_prompt
  local user_prompt
  local resp
  local operating_system="$(uname -s)"
  [[ "$operating_system" == "Darwin" ]] && operating_system="macOS"
  local response_schema='{"type":"object","properties":{"explanation":{"type":"string"},"warning":{"type":"string"},"command":{"type":"string"}},"required":["explanation","warning","command"],"additionalProperties":false}'

  # --- System Prompt with Dynamic Explanation Instructions ---
  sys_prompt=$(cat << EOF
You are an expert CLI assistant. Your task is to convert a natural language description of a desired shell operation into a structured JSON object.

You must respond with a valid JSON object and absolutely nothing else. Do not wrap the JSON in markdown code blocks.

The JSON object must contain exactly three keys:
1. "explanation": If the user requested an explanation ($include_explanation), provide a concise, step-by-step breakdown of *how* the command works under the hood so the user can learn. Do not just repeat or rephrase the user's goal. If the user did not request an explanation ($include_explanation is false) or the command is basic, leave this as an empty string "".
2. "warning": Use this field ONLY for severe, destructive risks (e.g., permanent deletion of data, killing processes, overwriting files) or if the command requires the user to manually replace placeholder text before running. If the command is purely informational, read-only, or safe, you MUST leave this as an empty string "". Do not provide generic safety advice or boilerplate warnings.
3. "command": A string containing ONLY the raw, executable shell command. Pay absolute attention to sorting requests and flags. No markdown, no backticks, ready to be executed.
EOF
)

  # --- User Prompt ---
  user_prompt=$(cat << EOF
Operating System/Shell: $operating_system/zsh

<user_goal>
$user_goal
</user_goal>

Respond strictly in the requested JSON format.
EOF
)

  # Fetch from LLM
  if ! resp=$(llm "$user_prompt" -s "$sys_prompt" --schema "$response_schema"); then
    print -r -- "Error: Could not generate a command." >&2
    return 1
  fi

  # Slurp to require exactly one JSON response. This validates structure, not
  # command safety; the user still reviews the command before executing it.
  if ! jq -se '
    length == 1 and (.[0] |
      type == "object" and
      keys == ["command", "explanation", "warning"] and
      (.explanation | type == "string") and
      (.warning | type == "string") and
      (.command | type == "string" and test("[^[:space:]]"))
    )
  ' <<< "$resp" >/dev/null 2>&1; then
    print -r -- "Error: The generated command response is invalid." >&2
    return 1
  fi

  # Extract fields using zsh here-strings
  local explanation=$(jq -r '.explanation' <<< "$resp")
  local warning=$(jq -r '.warning' <<< "$resp")
  local cmd=$(jq -r '.command' <<< "$resp")

  # Only static labels may use print -P: PROMPT_SUBST can execute substitutions
  # in model-generated text. Display response fields literally with print -r.
  if [[ -n "$explanation" && "$explanation" != "null" && "$explanation" != "" ]]; then
    print -Pn '%F{cyan}How it works:%f '
    print -r -- "$explanation"
  fi

  if [[ -n "$warning" && "$warning" != "null" && "$warning" != "" ]]; then
    print -Pn '%F{red}%B⚠️  WARNING:%b '
    print -r -- "$warning"
  fi

  print -P "%F{green}➜ Command loaded below. Press [Enter] to run, or edit it:%f"

  # Queue for editing; execution happens only when the user submits the buffer.
  print -z -- "$cmd"
}
