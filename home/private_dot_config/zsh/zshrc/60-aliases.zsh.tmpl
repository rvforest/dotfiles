# 60-aliases.zsh — aliases

# Global pipeline and redirection aliases. Space expands these visibly;
# Ctrl-Space skips that preview. Quote a token to use it literally.
alias -g ',H=| head'
alias -g ',T=| tail'
alias -g ',L=| less -R'
alias -g ',LL=2>&1 | less -R'
alias -g ',G=| rg'
alias -g ',F=| fzf'
alias -g ',C=| wc -l'
alias -g ',S=| sort'
alias -g ',U=| sort -u'
alias -g ',NUL=>/dev/null 2>&1'
alias -g ',NE=2>/dev/null'
alias -g ',CA=| cat -A'
# Keep OMZ's ga='git add' shortcut.
alias gals='alias -g'

# ls related
alias lt='eza --tree'

# uv tools - These inject the dependency into the existing environment.
# For example `jupyter` will start jupyter in the current venv even if it's not a dep
alias uvr='uv run'
alias ipython='uv run --with IPython ipython'
alias jupyter='uv run --with jupyter jupyter'
alias mlflow-ui='uv run --with=mlflow mlflow ui "--backend-store-uri=$MLFLOW_TRACKING_URI"'

# zellij
alias zr='zellij run'
alias ze='zellij edit'

# Misc tools
# Homebrew uses the upstream names; Debian packages may use alternate names.
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  alias bat=batcat
fi
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  alias fd=fdfind
fi
alias v=nvim
alias cza='chezmoi apply'

# ssh
alias ssh-on='_ts_ssh_set true'
alias ssh-off='_ts_ssh_set false'

# Git
alias wip='git stash --include-untracked > /dev/null && gcb "wip/$(git branch --show-current)" || gco "wip/$(git branch --show-current)" && git stash pop > /dev/null && gwip'
alias unwip='gunwip && gco "${$(git branch --show-current)#*wip/}" && git branch -D "wip/$(git branch --show-current)"'
