# 50-bindings.zsh — keybindings

ZVM_VI_ESCAPE_BINDKEY=jk

# Inspired by OMZ globalias: expand only complete, unquoted comma aliases.
# Avoid expand-word, which also expands globs and executes substitutions.
function _dotfiles_expand_global_alias() {
  local word=${${(Az)LBUFFER}[-1]}
  if [[ $word == ,* ]] && (( ${+galiases[$word]} )); then
    zle _expand_alias
  fi
  zle self-insert
}
zle -N _dotfiles_expand_global_alias

function _dotfiles_bind_keys() {
  bindkey -M viins "^[[A" history-beginning-search-backward
  bindkey -M viins "^[[B" history-beginning-search-forward

  local keymap
  for keymap in emacs viins; do
    bindkey -M "$keymap" ' ' _dotfiles_expand_global_alias
    # Skip visible alias expansion; quote tokens to suppress execution-time expansion.
    bindkey -M "$keymap" '^ ' magic-space
  done
}

_dotfiles_bind_keys
# Vi-mode initializes at the first prompt and resets keymaps. Reapply afterward.
if (( ${+functions[zvm_init]} )) &&
   (( ! ${zvm_after_init_commands[(Ie)_dotfiles_bind_keys]} )); then
  zvm_after_init_commands+=(_dotfiles_bind_keys)
fi
