#!/usr/bin/env bash
set -euo pipefail

{{ if not .is_mobile -}}
{{ template "bootstrap-env.sh" . }}

# Change this version deliberately to update Pi's runtime independently of
# project Node versions. Pi's own updates do not update Node.
node_version=v24.16.0
pi_agent_dir="$HOME/.pi/agent"
pi_root="$pi_agent_dir/install"
node_root="$XDG_DATA_HOME/dotfiles/pi-fnm"
node_install="$node_root/node-versions/$node_version/installation"
node_link="$XDG_DATA_HOME/pi-node/current"

# Never migrate or replace a Pi installed by another package manager.
existing_pi=$(command -v pi || true)
if [[ -n "$existing_pi" ]] && { [[ ! -f "$pi_root/managed-install.json" ]] || [[ "$(readlink -f "$existing_pi")" != "$(readlink -f "$pi_agent_dir/bin/pi")" ]]; }; then
    echo "Pi already exists at $existing_pi; leaving that installation and its configuration alone." >&2
    exit 0
fi

if [[ -e "$node_link" || -L "$node_link" ]]; then
    if [[ ! -L "$node_link" || "$(readlink "$node_link")" != "$node_root"/node-versions/*/installation ]]; then
        echo "Pi's Node runtime at $node_link is not managed by dotfiles; leaving it alone." >&2
        exit 1
    fi
fi

if [[ ! -x "$node_install/bin/node" || ! -x "$node_install/bin/npm" ]]; then
    command -v fnm >/dev/null || { echo 'fnm is required to install Pi’s Node runtime.' >&2; exit 1; }
    FNM_DIR="$node_root" fnm install "$node_version"
fi
mkdir -p "${node_link%/*}"
if [[ ! -L "$node_link" || "$(readlink "$node_link")" != "$node_install" ]]; then
    ln -sfn "$node_install" "$node_link"
fi

if [[ ! -f "$pi_root/managed-install.json" ]]; then
    installer=$(mktemp)
    log=$(mktemp)
    trap 'rm -f "$installer" "$log"' EXIT
    curl -fsSL https://pi.dev/install.sh -o "$installer"
    # Redirect output as well as stdin: the upstream installer detects a TTY
    # on stdout and otherwise offers interactive migration/startup prompts.
    if env -u PI_MANAGED_INSTALL_ROOT -u PI_LEGACY_INSTALL PI_CODING_AGENT_DIR="$pi_agent_dir" PATH="$node_install/bin:$HOME/.local/bin:$PATH" sh "$installer" </dev/null >"$log" 2>&1; then
        cat "$log"
    else
        cat "$log" >&2
        exit 1
    fi
fi

# Pi owns these files at runtime. Preserve custom credentials and settings;
# migrate only the exact OpenRouter command previously installed by dotfiles.
umask 077
mkdir -p "$pi_agent_dir"
for file in auth.json settings.json; do
    path="$pi_agent_dir/$file"
    [[ -e "$path" ]] || printf '{}\n' > "$path"
    tmp=$(mktemp "$pi_agent_dir/.dotfiles-pi.XXXXXX")
    if [[ "$file" == auth.json ]]; then
        filter='if type != "object" then error("expected an object") elif (has("openrouter") | not) then . + {openrouter: {type: "api_key", key: "!pass show keys/openrouter/pi"}} elif (.openrouter | type) == "object" and .openrouter.type == "api_key" and .openrouter.key == "!pass show keys/openrouter" then .openrouter.key = "!pass show keys/openrouter/pi" else . end'
    else
        filter='if type != "object" then error("expected an object") elif has("defaultProvider") then . else . + {defaultProvider: "openrouter"} end'
    fi
    if ! jq "$filter" "$path" > "$tmp"; then
        rm -f "$tmp"
        echo "Could not update $path; original left intact." >&2
        exit 1
    fi
    if cmp -s "$path" "$tmp"; then
        rm -f "$tmp"
    else
        mv -f "$tmp" "$path"
    fi
done
{{- end }}
