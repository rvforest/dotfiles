#!/usr/bin/env bash

set -euo pipefail

{{ template "bootstrap-env.sh" . }}

# Check if homebrew is already installed
if command -v brew >/dev/null 2>&1; then
    echo "Homebrew is already installed."
    exit 0
fi


echo "Installing Homebrew..."

# Keep download failure visible to set -e; bash -c "" would otherwise succeed
# and chezmoi would record this stage as complete without installing anything.
homebrew_installer=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)
/bin/bash -c "$homebrew_installer"

# Add homebrew to PATH for this session
{{ template "homebrew-env.sh" . }}
command -v brew >/dev/null

echo "Homebrew installation completed."
