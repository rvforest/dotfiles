#!/usr/bin/env bash

set -euo pipefail

{{ template "bootstrap-env.sh" . }}

gh_host=github.com
# If not logged in, then log in with web browser
if ! gh auth status --hostname $gh_host &> /dev/null; then
  echo "Logging into GitHub"
  gh auth login \
    --hostname "$gh_host" \
    --git-protocol https \
    --scopes admin:ssh_signing_key \
    --web
fi

# The managed Git config already uses gh auth git-credential for GitHub/gists.
# gh auth setup-git would rewrite that chezmoi-owned file after it was applied.

