#!/usr/bin/env bash
set -euo pipefail

{{ template "bootstrap-env.sh" . }}

if ! command -v fnm >/dev/null 2>&1; then
    echo "fnm not found; tool setup must complete before installing Node.js." >&2
    exit 1
fi

fnm_env=$(fnm env --shell bash)
eval "$fnm_env"

# Honor an existing default. A fresh machine gets the current LTS once, rather
# than changing Node major versions on unrelated future configuration updates.
if ! fnm use default; then
    fnm install --lts --use
    fnm default "$(fnm current)"
fi

# Neovim's npm-based tools need both commands in the selected runtime.
node --version
npm --version

# Keep ordinary npm CLIs declarative. Install missing packages without upgrading
# existing installations on unrelated dotfiles changes.
packages=(
{{- range .npm.packages.core }}
    {{ . | quote }}
{{- end }}
{{- if not .is_mobile }}
{{- range .npm.packages.desktop }}
    {{ . | quote }}
{{- end }}
{{- end }}
)
for package in "${packages[@]}"; do
    if ! npm list --global --depth=0 "$package" >/dev/null 2>&1; then
        npm install --global "$package"
    fi
done
