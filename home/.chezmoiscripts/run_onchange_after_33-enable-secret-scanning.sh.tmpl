#!/usr/bin/env bash
set -euo pipefail

{{ template "bootstrap-env.sh" . }}

# Install the existing secret-scanning hook only in this dotfiles checkout.
if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit not found; tool setup must complete before installing the dotfiles hook." >&2
    exit 1
fi

# .chezmoiroot can put sourceDir inside home/; the hook configuration lives
# at the Git repository root.
repo_root=$(git -C "{{ .chezmoi.sourceDir }}" rev-parse --show-toplevel)
if [[ ! -f "$repo_root/.pre-commit-config.yaml" ]]; then
    echo "No dotfiles pre-commit configuration found at $repo_root." >&2
    exit 1
fi

cd "$repo_root"
pre-commit install --install-hooks
